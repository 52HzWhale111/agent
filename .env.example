# 复制成 .env 再填真实值；.env 已被 .gitignore 忽略，绝对不要提交

# 数据库
DATABASE_URL=postgresql://zhigou:change-me@localhost:5432/zhigou

# 模型 / Agent
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 服务地址
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8001
KNOWLEDGE_AGENT_URL=http://localhost:8100
SANDBOX_AGENT_URL=http://localhost:8200
SANDBOX_PROTOCOL=text

# 超时（秒）
QA_TIMEOUT=30
DOC_REVIEW_TIMEOUT=60
CODE_RUN_TIMEOUT=120

# 上传限制
MAX_UPLOAD_MB=20

# 接入层（上线必须填随机强口令；不要把密钥写入前端构建产物）
GATEWAY_API_KEY=
GATEWAY_DATA_DIR=./data
MAX_PENDING_TASKS=100

# Docker Compose：填写团队真实镜像，端口约定见 docs/agent-integration.md
KNOWLEDGE_IMAGE=
SANDBOX_IMAGE=
SANDBOX_WORK_DIR=/opt/zhigou/sandbox-work
SANDBOX_EXECUTION_IMAGE=zhigou-sandbox-jdk17:v1
FRONTEND_IMAGE=
BACKEND_IMAGE=
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
DOMAIN=
ACME_EMAIL=
# 优先读取私密 SMTP JSON（见 docs/1022-免费邮件告警-v1.md）；不提交账号授权码
ALERT_DATA_DIR=../data/local/alerts
# 可选的旧版通用 JSON Webhook；SMTP 未配置时使用
ALERT_WEBHOOK_URL=
