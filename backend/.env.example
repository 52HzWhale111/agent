# Set these as environment variables. No secrets are required for local development.
APP_ENV=development
DATABASE_URL=sqlite:///./data/zhigou.db
# PostgreSQL for backend 2: postgresql+psycopg://zhigou:YOUR_PASSWORD@db:5432/zhigou
# Production requires a random JWT_SECRET_KEY of at least 32 characters.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=20
UPLOAD_DIR=./storage
