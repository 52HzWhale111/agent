{$DOMAIN} {
    request_body {
        max_size 21MB
    }
    handle_path /ops/backup/* {
        header Cache-Control no-store
        @operator {
            header Authorization "Bearer {$GATEWAY_API_KEY}"
            path /index.json /snapshot-*.cms
        }
        handle @operator {
            root * /backup-export
            file_server {
                hide .*
            }
        }
        respond 404
    }
    handle /api/* {
        reverse_proxy gateway:8000
    }
    handle /health/* {
        reverse_proxy gateway:8000
    }
    handle_path /business/* {
        reverse_proxy backend:8000
    }
    @gateway_docs path /docs /docs/* /redoc /openapi.json
    handle @gateway_docs {
        reverse_proxy gateway:8000
    }
    handle {
        redir * /docs 302
    }
    log {
        output stdout
    }
}
